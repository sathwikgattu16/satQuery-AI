# =================================================================
# SatQuery AI — Environment Configuration Template (.env.example)
# Copy this file to .env and configure local values as needed.
# =================================================================

# Mode: Set to "true" to activate real Prithvi neural weights and specialist heads in ml/models/
# Default is "false" for safe, instantaneous offline judging and demo mode.
USE_REAL_MODELS=false

# Prithvi-EO-2.0 Foundation Model Checkpoint Path (e.g. checkpoints/prithvi_eo_v2_100_tl.pt)
PRITHVI_CHECKPOINT=

# Parameter-Efficient Fine-Tuning / LoRA Adapter Path (e.g. checkpoints/prithvi_lora_last.pt)
LORA_ADAPTER_PATH=

# Hardware Compute Device ("auto", "cuda:0", "cpu")
# "auto" automatically queries torch.cuda.is_available() and falls back to "cpu"
MODEL_DEVICE=auto
